# ── App ──────────────────────────────────────────────
PORT=4000
DATA_DIR=./data
# Delete uploaded datasets after this many days
RETENTION_DAYS=7
# Email domains never sent to CleverTap (internal / test accounts)
EXCLUDE_DOMAINS=urbanladder.com
# Excel dates like 12/10/2026 are read day-first (DMY) or month-first (MDY)
DATE_ORDER=DMY
# Warn when the data is older than this many days; block when older than the second number
STALE_WARN_DAYS=3
STALE_BLOCK_DAYS=14

# ── Encryption keys (generated by `npm run keys`; in production these live in AWS KMS / Secrets Manager)
ENC_KEY=
HMAC_KEY=

# ── CleverTap (leave ACCOUNT_ID empty = dry-run: nothing is sent)
CT_ACCOUNT_ID=
CT_PASSCODE=
# India = in1. To test with the local mock: CT_BASE_URL=http://localhost:4010
CT_REGION=in1
CT_BASE_URL=
CT_ADMIN_EMAIL=

# ── Power BI (leave TENANT_ID empty = Power BI source shows as "not configured")
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_DATASET_ID=
# Override only for testing against a mock
PBI_LOGIN_BASE=https://login.microsoftonline.com
PBI_API_BASE=https://api.powerbi.com
PBI_PAGE_SIZE=100000

{
  "name": "cohort-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Cohort Builder: build customer segments from Power BI or Excel and push them to CleverTap as custom lists, without exposing raw emails.",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run keys && npm run sample",
    "keys": "tsx scripts/gen-keys.ts",
    "sample": "tsx scripts/make-sample.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "mock:clevertap": "tsx server/mock-clevertap.ts",
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx scripts/smoke-test.ts",
    "start": "vite build && tsx server/index.ts"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "multer": "2.0.2",
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.13.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
